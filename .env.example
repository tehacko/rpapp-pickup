# =============================================================================
# RPAPP-PICKUP LOCAL DEVELOPMENT — ENV TEMPLATE
# =============================================================================
# Copy to .env and fill in values. DO NOT commit .env (real secrets).
# Default API uses Vite proxy to localhost:3015 when VITE_API_URL is unset.
# =============================================================================

# Leave EMPTY so the browser calls same-origin /api (credentials include).
# Local: Vite proxies /api → :3015. Prod: Caddy reverse_proxies /api + /events
# via API_PROXY_UPSTREAM. Do NOT set a cross-origin absolute URL — cookies fail.
# VITE_API_URL=

# Deploy-only (Caddy / Railway): REQUIRED backend origin for same-origin /api
# + /events proxy. Scheme+host[+port] only — no path, no trailing slash.
# Example: https://rpapp-backend.up.railway.app  or  http://localhost:3015
# API_PROXY_UPSTREAM=http://localhost:3015

# Local debug only (cross-origin from :3005; cookies will not attach).
# VITE_API_URL=http://localhost:3015
# Default tenant code preselected in local pickup UI (default railway-cafe).
# VITE_DEFAULT_TENANT_CODE=railway-cafe
# Default UI locale for local pickup (default cs).
# VITE_DEFAULT_LOCALE=cs
# Force PWA update prompt behavior in local builds (default false).
# VITE_PWA_FORCE_UPDATE=false
# App version string shown in local/dev builds (default dev).
# VITE_APP_VERSION=dev
# CI/build id stamped into the client bundle; empty in local .
# VITE_BUILD_ID=
# Build version label stamped into the client bundle (default dev).
# VITE_BUILD_VERSION=dev
# Sentry DSN for client error reporting; leave empty to disable locally.
# VITE_SENTRY_DSN=
# Sentry environment tag for local client reports (default development).
# VITE_SENTRY_ENVIRONMENT=development
