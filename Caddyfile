# Railway / Railpack: same-origin static + /api reverse_proxy.
# Custom `npm start` disables SPA auto-Caddy — railpack.json installs mise `caddy`.
# Set API_PROXY_UPSTREAM on the pickup service (scheme+host[+port] only — no path/trailing /).
# Pair with empty VITE_API_URL so the SPA calls same-origin /api (HttpOnly cookies + SameSite=Lax).
# Bare `serve -s` SPA-fallbacks /api to index.html → "Unexpected token '<' … is not valid JSON".

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	# Same-origin cookie topology — MUST: /api/* AND /events/* → API_PROXY_UPSTREAM
	# /health matches Vite preview proxy so liveness can reflect the API when used.
	@upstream_api path /api/* /events/* /health
	handle @upstream_api {
		reverse_proxy {$API_PROXY_UPSTREAM} {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Forwarded-Proto {http.request.scheme}
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	# PWA no-store + SW-Allowed — live spawn is start.js → Caddy (not serve.json).
	# Locales + runtime-config must not stick across deploys (Update / soft reload).
	@pwa_sw path /sw.js
	@pwa_manifests path /manifest.webmanifest /manifest-dev.webmanifest
	@pwa_runtime_config path /runtime-config.json /runtime-config.js
	@pwa_locales path /locales/*
	@static_assets path /assets/*

	# Hashed Vite chunks — never SPA-fallback to index.html (MIME poison on stale deploy).
	# PROOF /assets/* immutable: this dedicated handle runs before the SPA catch-all below
	# and sets Cache-Control "public, max-age=31536000, immutable". Deep-link SPA no-store
	# lives only in the catch-all handle — never merge asset serving into that block, and
	# never use a prefix `path /` matcher that would apply no-store onto /assets/*.
	handle @static_assets {
		root * dist

		header {
			X-Content-Type-Options "nosniff"
			-Server
		}

		header Cache-Control "public, max-age=31536000, immutable"

		encode {
			gzip
			zstd
		}

		file_server {
			hide .git
			hide .env*
		}
	}

	handle {
		root * dist

		header {
			X-Content-Type-Options "nosniff"
			-Server
		}

		# SPA shell documents: `/`, `/index.html`, and deep links (try_files → /index.html).
		# Request path stays the deep route, so a narrow ^/(|index\.html)$ matcher missed them.
		# Default no-store on this handle only — /assets/* is handled above with immutable.
		header Cache-Control "no-cache, no-store, must-revalidate"
		header @pwa_sw Cache-Control "no-cache, no-store, must-revalidate"
		header @pwa_sw Service-Worker-Allowed "/"
		header @pwa_manifests Cache-Control "no-cache, no-store, must-revalidate"
		header @pwa_runtime_config Cache-Control "no-cache, no-store, must-revalidate"
		header @pwa_locales Cache-Control "no-cache, must-revalidate"

		encode {
			gzip
			zstd
		}

		file_server {
			hide .git
			hide .env*
		}

		try_files {path} {path}.html {path}/index.html /index.html
	}
}
